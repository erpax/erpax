# Copy to `.env.local` or run `pnpm run setup` after install (prompts for these values).

# Required for Payload (generate: openssl rand -hex 32)
PAYLOAD_SECRET=

# Optional: sealed PAYLOAD_SECRET at rest (JSON SealedBlob or path). Requires ERPAX_SEAL_KEY.
# PAYLOAD_SECRET_SEALED=
# ERPAX_SEAL_KEY=
# PAYLOAD_SECRET_IDENTITY_JSON=  # override default identity descriptor (see src/secret/SKILL.md)

# Wrangler environment name when using `wrangler deploy --env <name>` (optional)
CLOUDFLARE_ENV=

# Optional: canonical public URL. When unset, the app uses the incoming request Host
# (and optional tenant `publicSiteUrl` on Tenants) for links, OG URLs, and ecommerce client.
NEXT_PUBLIC_SERVER_URL=

# Root marketing site tenant slug (multi-tenant)
NEXT_PUBLIC_SITE_TENANT_SLUG=

# Resend: primary keys live on each Tenant (Tenants → Resend API key). These env vars are optional
# fallbacks for local development only.
RESEND_API_KEY=
EMAIL_DEFAULT_FROM_ADDRESS=
EMAIL_DEFAULT_FROM_NAME=

# Preview, cron job auth, etc. use secrets derived from PAYLOAD_SECRET (see src/utilities/deriveSecret.ts).

# Stripe: secret key, webhook signing secret, and publishable key should be set per Tenant in production.
# These env vars are optional fallbacks for local development (non-production only for publishable key).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payload MCP (optional)
PAYLOAD_MCP_API_KEY=
PAYLOAD_MCP_URL=

# Trello (optional — src/trello). Key + token from a Power-Up at trello.com/power-ups/admin
# (API Key tab; the same page issues the token). THE TOKEN GRANTS FULL ACCOUNT ACCESS: keep it in
# the environment only — never commit it, never put it on a field. Without both, the Trello plugin
# stays inert (the card-id field is still injected for any mapped collection, so schema never
# drifts on an env var). In production set them as Worker secrets:
#   wrangler secret put TRELLO_API_KEY  ·  wrangler secret put TRELLO_TOKEN
TRELLO_API_KEY=
TRELLO_TOKEN=
# ── research lanes ──────────────────────────────────────────────────────────────
# YouTube Data API v3 — METADATA only (titles, ids, descriptions). It cannot read another
# channel's captions: captions.download needs OAuth as the video OWNER, so an API key gets you
# the playlist, never the transcript. Quota is per DAY and spent per CALL — 10,000 units, with
# search.list at 100 and playlistItems.list at 1, so a hundred searches exhausts a day.
# Production: wrangler secret put YOUTUBE_API_KEY
YOUTUBE_API_KEY=
# Crossref · OpenAlex · arXiv · Wikidata need NO credential at all — they are wired keyless in
# src/api/integration/seed.ts and work on a clean checkout. Crossref's polite pool asks only for
# a contact address in the User-Agent, which buys a better lane and is not authentication.
# Optional: the board whose lists the client reads (getLists).
TRELLO_BOARD_ID=
# Optional: opt into the flag-gated Trello MCP server in .mcp.json (agent conversations about a
# board — NOT the sync path). Off unless set to 1/true.
TRELLO_MCP_ENABLED=

# --- PQC library bindings (src/anchor/surface). Named PER SURFACE, not globally: a root sealed by
# FIPS 205 and a channel keyed by FIPS 203 are different bindings and different failures. The
# surface guard READS these — an unset binding makes the manifest report that surface `open` with
# its owner named, instead of a `sealed` status resting on a string nobody checked.
#   root      must implement FIPS 205 SLH-DSA (primary, no new assumption) or FIPS 204 ML-DSA
#   kem       must implement FIPS 203 ML-KEM — mandatory on every channel that exchanges state
#   storage   at-rest cipher (e.g. AES-256-GCM, NIST SP 800-38D)
# Key IDs are credentials, never key material. In production: wrangler secret put PQC_ROOT_KEY_ID
PQC_ROOT_PROVIDER=
PQC_KEM_PROVIDER=
PQC_STORAGE_PROVIDER=
PQC_ROOT_KEY_ID=
PQC_KEM_KEY_ID=

# --- Cloudflare bindings live in `wrangler.jsonc` (D1, R2, ASSETS, IMAGES, services).
# Run `pnpm run setup` to set account_id, worker name, D1 database_id, R2 bucket, etc.
