{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/confirm.mjs --hook",
            "timeout": 60,
            "statusMessage": "confirming edit — payload ⊕ vitepress"
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/src/rules/**/README.md",
    "**/src/rules/**/LLM.md",
    "**/.claude/rules/**/README.md",
    "**/.claude/rules/**/LLM.md",
    "**/src/rules/*/SKILL.md",
    "**/src/rules/*/**/SKILL.md",
    "**/.claude/rules/*/SKILL.md",
    "**/.claude/rules/*/**/SKILL.md"
  ]
}
