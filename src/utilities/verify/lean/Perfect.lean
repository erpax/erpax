set_option maxRecDepth 100000 in
theorem every_row_is_a_commutator : table.all (fun (g, a, b) => commutator a b == g) = true := by decide

set_option maxRecDepth 100000 in
theorem every_entry_lies_in_A5 : table.all (fun (g, a, b) => even g && even a && even b) = true := by decide

set_option maxRecDepth 100000 in
/-- 60 distinct elements of A5, each a commutator: A5 is perfect, its abelianization trivial. -/
theorem sixty_distinct_commutators : (table.map (·.1)).length = 60 ∧ (table.map (·.1)).Nodup := by decide

end Perfect
