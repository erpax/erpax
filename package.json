{
  "name": "erpax",
  "version": "1.0.3",
  "private": true,
  "description": "Source-available multi-tenant ERP & double-entry accounting on Payload CMS v4 + Cloudflare (D1 + R2 + Workers via OpenNext) — content-addressed, tamper-evident, standards-bound",
  "author": {
    "name": "Tsvetan Rouschev",
    "url": "https://orcid.org/0009-0000-7312-9778"
  },
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next dev",
    "dev:clean": "rm -rf .next .open-next && pnpm dev",
    "build:next": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=./src/css/load-hook.mjs\" next build --turbopack",
    "build:next:webpack": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=./src/css/load-hook.mjs\" next build --webpack",
    "build": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=tsx/esm --import=./src/css/load-hook.mjs\" payload generate:types && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=tsx/esm --import=./src/css/load-hook.mjs\" payload generate:importmap && pnpm build:next",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore NODE_OPTIONS=\"--no-deprecation --import=tsx/esm --import=./src/css/load-hook.mjs\" payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote && opennextjs-cloudflare build && node scripts/cleanup-ui-assets.mjs && opennextjs-cloudflare deploy",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=tsx/esm --import=./src/css/load-hook.mjs\" payload",
    "prepare": "node scripts/setup-env.mjs --if-needed && husky",
    "setup": "node scripts/setup-env.mjs",
    "check": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/cli/index.ts gate",
    "erpax": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=tsx/esm\" tsx src/cli/index.ts",
    "payload:migrate:create": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000 --import=./src/css/load-hook.mjs\" payload migrate:create",
    "readme:waves": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/legacy-shim.ts",
    "readme:check": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/legacy-shim.ts",
    "rules:check": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/legacy-shim.ts",
    "test:int": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/legacy-shim.ts",
    "confirm:uuid": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/legacy-shim.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@opennextjs/cloudflare": "^1.20.2",
    "@payloadcms/admin-bar": "4.0.0-internal.38b7f1d",
    "@payloadcms/db-d1-sqlite": "4.0.0-internal.38b7f1d",
    "@payloadcms/email-resend": "4.0.0-internal.38b7f1d",
    "@payloadcms/live-preview-react": "4.0.0-internal.38b7f1d",
    "@payloadcms/next": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-ecommerce": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-form-builder": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-import-export": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-mcp": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-multi-tenant": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-nested-docs": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-redirects": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-search": "4.0.0-internal.38b7f1d",
    "@payloadcms/plugin-seo": "4.0.0-internal.38b7f1d",
    "@payloadcms/richtext-lexical": "4.0.0-internal.38b7f1d",
    "@payloadcms/sdk": "4.0.0-internal.38b7f1d",
    "@payloadcms/storage-r2": "4.0.0-internal.38b7f1d",
    "@payloadcms/translations": "4.0.0-internal.38b7f1d",
    "@payloadcms/ui": "4.0.0-internal.38b7f1d",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "graphql": "^17.0.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-internal.38b7f1d",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "2.15.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "uuid": "latest",
    "vaul": "^1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.26",
    "@payloadcms/eslint-plugin": "^3.28.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/escape-html": "^1.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "postcss": "latest",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "sqlite3",
      "unrs-resolver",
      "workerd"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
