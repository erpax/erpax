{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc-typecheck.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "payload-next-css.d.ts",
    "cloudflare-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", "src/worktrees", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
