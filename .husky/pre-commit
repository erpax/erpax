#!/usr/bin/env sh
# Regenerate Payload's generated files when a collection, field or the config changes.
cd "$(dirname "$0")/.." || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if echo "$staged" | grep -qE '^src/.*\.(ts|tsx)$'; then
  pnpm -s generate:types >/dev/null && pnpm -s generate:importmap >/dev/null
  git add src/payload-types.ts 'src/app/(payload)/admin/importMap.js' 2>/dev/null || true
fi
