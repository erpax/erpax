{
  "name": "@erpax/chat",
  "version": "1.0.10",
  "description": "Chat — rooms, messages, connections. An erpax app, delivered as one Payload plugin. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/packages/chat/.package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/chat/.package.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/chat"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/chat",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs chat",
    "prepublishOnly": "node ../build.mjs chat"
  },
  "erpax": {
    "generated": true,
    "entryFile": "packages/chat/.package.ts",
    "closureCeiling": 7
  },
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "erpax",
    "chat"
  ],
  "dependencies": {
    "uuid": "latest"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
