{
  "name": "@erpax/identity",
  "version": "0.1.7",
  "description": "Content-addressed identity — RFC 9562 v8 uuids folded from content, so the same content is always the same id. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/identity/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/identity/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/identity"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/identity",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs identity",
    "prepublishOnly": "node ../build.mjs identity"
  },
  "erpax": {
    "closureCeiling": 10
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "keywords": [
    "uuid",
    "content-addressing",
    "rfc9562",
    "identity",
    "deduplication",
    "erpax"
  ]
}
