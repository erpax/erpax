{
  "name": "@erpax/admin",
  "version": "1.0.8",
  "description": "Admin — who is here and what they may do: tenants, users, roles. An erpax app, delivered as one Payload plugin. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/packages/admin/.package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/admin/.package.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/admin",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs admin",
    "prepublishOnly": "node ../build.mjs admin"
  },
  "erpax": {
    "generated": true,
    "entryFile": "packages/admin/.package.ts",
    "closureCeiling": 8
  },
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "erpax",
    "admin"
  ],
  "dependencies": {
    "@payloadcms/plugin-multi-tenant": "4.0.0-internal.38b7f1d",
    "uuid": "latest"
  },
  "peerDependencies": {
    "payload": "4.0.0-internal.38b7f1d"
  }
}
