{
  "name": "@erpax/comply",
  "version": "1.0.8",
  "description": "Comply — frameworks, controls, evidence, risk. An erpax app, delivered as one Payload plugin. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/packages/comply/.package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/comply/.package.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/comply"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/comply",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs comply",
    "prepublishOnly": "node ../build.mjs comply"
  },
  "erpax": {
    "generated": true,
    "entryFile": "packages/comply/.package.ts",
    "closureCeiling": 6
  },
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "erpax",
    "comply"
  ],
  "dependencies": {
    "uuid": "latest"
  }
}
