{
  "name": "@erpax/plugin-taggable",
  "version": "1.0.9",
  "description": "Payload plugin: tag any record in any collection by its content-uuid — one text column instead of a relationship table per collection. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/plugins/taggable/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/plugins/taggable/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/taggable"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/taggable",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs taggable",
    "prepublishOnly": "node ../build.mjs taggable"
  },
  "erpax": {
    "entry": "plugins/taggable",
    "closureCeiling": 1,
    "sizeCeilingKb": 3
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "tags",
    "polymorphic",
    "erpax"
  ]
}
