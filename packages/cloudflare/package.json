{
  "name": "@erpax/cloudflare",
  "version": "0.1.14",
  "description": "Cloudflare Workers surface for erpax — binding registries, AI-gateway keys, wrangler env shapes, deploy faces. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/cloudflare/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/cloudflare/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/cloudflare",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs cloudflare",
    "prepublishOnly": "node ../build.mjs cloudflare"
  },
  "erpax": {
    "closureCeiling": 15,
    "sizeCeilingKb": 101,
    "entry": "utilities/cloudflare"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "d1",
    "bindings",
    "erpax"
  ]
}
