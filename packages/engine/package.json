{
  "name": "@erpax/engine",
  "version": "1.0.12",
  "description": "Engine — erpax split into Payload plugins, one per app, the way a workspace suite is split. Part of erpax. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/packages/engine/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/engine/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/engine",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs engine",
    "prepublishOnly": "node ../build.mjs engine"
  },
  "erpax": {
    "generated": true,
    "entryFile": "packages/engine/index.ts",
    "closureCeiling": 1
  },
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "erpax",
    "engine"
  ]
}
