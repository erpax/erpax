{
  "name": "@erpax/sales",
  "version": "1.0.10",
  "description": "Sales — selling: parties, orders, invoices, subscriptions. An erpax app, delivered as one Payload plugin. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/packages/sales/.package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/sales/.package.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/sales"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/sales",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs sales",
    "prepublishOnly": "node ../build.mjs sales"
  },
  "erpax": {
    "generated": true,
    "entryFile": "packages/sales/.package.ts",
    "closureCeiling": 7
  },
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "erpax",
    "sales"
  ],
  "dependencies": {
    "typescript": "5.9.3",
    "uuid": "latest",
    "zod": "3.25.76"
  }
}
