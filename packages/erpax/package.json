{
  "name": "@erpax/erpax",
  "version": "0.1.0",
  "description": "Orientation face for erpax — resolve the canonical repo to its sealed skill entry and agent surfaces. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/erpax/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/erpax/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/erpax"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/erpax",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs erpax",
    "prepublishOnly": "node ../build.mjs erpax"
  },
  "erpax": {
    "closureCeiling": 4,
    "sizeCeilingKb": 3
  },
  "keywords": [
    "erpax",
    "agent",
    "skills",
    "orientation",
    "mcp"
  ]
}
