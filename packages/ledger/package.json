{
  "name": "@erpax/ledger",
  "version": "1.0.12",
  "description": "Ledger — the books: accounts, journals, periods, banks, tax. An erpax app, delivered as one Payload plugin. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/packages/ledger/.package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/packages/ledger/.package.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/ledger"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/ledger",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs ledger",
    "prepublishOnly": "node ../build.mjs ledger"
  },
  "erpax": {
    "generated": true,
    "entryFile": "packages/ledger/.package.ts",
    "closureCeiling": 7
  },
  "keywords": [
    "payload-cms",
    "payload-plugin",
    "erpax",
    "ledger"
  ],
  "dependencies": {
    "typescript": "5.9.3",
    "uuid": "latest"
  },
  "peerDependencies": {
    "payload": "4.0.0-internal.38b7f1d"
  }
