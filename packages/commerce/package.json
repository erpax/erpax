{
  "name": "@erpax/commerce",
  "version": "0.1.0",
  "description": "Commerce lifecycle for erpax — checkout, subscriptions, usage metering, instance provisioning. CC-BY-NC-ND-4.0, or commercial via license@erpax.com.",
  "license": "CC-BY-NC-ND-4.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/commerce/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/commerce/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erpax/erpax.git",
    "directory": "packages/commerce"
  },
  "homepage": "https://github.com/erpax/erpax/tree/main/packages/commerce",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "node ../build.mjs commerce",
    "prepublishOnly": "node ../build.mjs commerce"
  },
  "erpax": {
    "closureCeiling": 1,
    "sizeCeilingKb": 3
  },
  "keywords": [
    "commerce",
    "subscriptions",
    "checkout",
    "usage-metering",
    "billing",
    "erpax"
  ]
}
